# OTP: server-only. Never prefix secrets with NEXT_PUBLIC_. Do not log request bodies.
# IPPanel Edge access key, assigned E.164 sender, approved pattern and its code placeholder.
IPPANEL_API_KEY=
IPPANEL_SENDER_NUMBER=
IPPANEL_PATTERN_CODE=
IPPANEL_PATTERN_PARAM=otp

# Independent random secrets (generate each with openssl rand -hex 32).
# Share only OTP_ASSERTION_SECRET with the Medusa phone-otp provider.
OTP_CHALLENGE_SECRET=
OTP_ASSERTION_SECRET=
OTP_MEDUSA_URL=http://127.0.0.1:9000

# Required absolute SQLite path in a pre-created, private (0700), persistent directory.
# All workers must use the SAME local file. Not for ephemeral/multi-host deployments.
OTP_DB_PATH=

# Optional single-IP header. Enable only behind a trusted proxy that OVERWRITES it
# and blocks direct access to the storefront. Missing/malformed values then fail closed.
OTP_TRUSTED_IP_HEADER=
